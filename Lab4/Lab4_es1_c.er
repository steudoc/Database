{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":false},"erDesign":{"model":{"uid":30,"erCode":"/* Entities */\nentity STANZA {\n    CodS (id),\n    piano,\n    superficie,\n    optional (optional, multi)\n}\nentity SUITE {\n    spazi (multi)\n}\nentity AGENZIA {\n    tel,\n    indirizzo {\n        CAP,\n        numero,\n        citta,\n        via,\n        stato\n    },\n    sito_web (optional),\n    CodA (id)\n}\nentity PRENOTAZIONE {\n    data_fine,\n    data_inizio (external),\n    costo\n}\n\n/* Relationships */\nrelationship PER (\n    STANZA: zero..many,\n    PRENOTAZIONE: one..one external\n)\nrelationship STIPULA (\n    PRENOTAZIONE: one..one,\n    AGENZIA: one..many\n)\n\n/* Generalizations */\nSTANZA <= {\n    SUITE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"STANZA","_x":-1136,"_y":-316,"_mag":false},{"__type":"Attribute","_id":2,"_name":"CodS","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-140,"_y":0},{"__type":"Attribute","_id":3,"_name":"piano","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":-42},{"__type":"Attribute","_id":4,"_name":"superficie","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":42},{"__type":"Attribute","_id":5,"_name":"optional","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_N","_parentId":1,"_x":-116,"_y":-78},{"__type":"Entity","_id":6,"_name":"SUITE","_x":-1139,"_y":-124,"_mag":false},{"__type":"Generalization","_id":7,"_type":"p_e","_entityId":1},{"__type":"GeneralizationChild","_id":8,"_entityId":6,"_generalizationId":7},{"__type":"Attribute","_id":9,"_name":"spazi","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_N","_parentId":6,"_x":-140,"_y":0},{"__type":"Entity","_id":10,"_nam