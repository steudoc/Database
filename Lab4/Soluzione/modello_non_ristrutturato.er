olumnId":71}}},"edited":false,"sceneResetToken":1683268435749,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showOneToManyTypeBRelationshipMenu":false,"showOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false},"schemaDesign":{"model":{"uid":92,"erCode":"/* Entities */\nentity PRENOTAZIONE {\n    DataFine,\n    Costo,\n    DataInizio (external)\n}\nentity STANZA {\n    Piano,\n    CodS (id),\n    Optional (optional, multi),\n    Superficie\n}\nentity SUITE {\n    Spazi (multi)\n}\nentity AGENZIA {\n    Indirizzo {\n        Via,\n        CAP,\n        Citta,\n        Numero,\n        Stato\n    },\n    CodA (id),\n    SitoWeb,\n    Tel\n}\n\n/* Relationships */\nrelationship PER (\n    STANZA: zero..many,\n    PRENOTAZIONE: one..one external\n)\nrelationship PRESSO (\n    AGENZIA: zero..many,\n    PRENOTAZIONE: one..one\n)\n\n/* Generalizations */\nSTANZA <= {\n    SUITE\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE AGENZIA (\n    CodA INTEGER NOT NULL,\n    SitoWeb TEXT NOT NULL,\n    Tel TEXT NOT NULL,\n    Via_Indirizzo TEXT NOT NULL,\n    CAP_Indirizzo INTEGER NOT NULL,\n    Citta_Indirizzo TEXT NOT NULL,\n    Numero_Indirizzo INTEGER NOT NULL,\n    Stato_Indirizzo TEXT NOT NULL,\n    PRIMARY KEY (CodA)\n);\nCREATE TABLE STANZA (\n    CodS INTEGER NOT NULL,\n    Piano INTEGER NOT NULL,\n    Superficie INTEGER NOT NULL,\n    Type TEXT NOT NULL,\n    PRIMARY KEY (CodS)\n);\nCREATE TABLE PRENOTAZIONE (\n    STANZA_CodS INTEGER NOT NULL,\n    DataInizio TEXT NOT NULL,\n    DataFine TEXT NOT NULL,\n    Costo REAL NOT NULL,\n    AGENZIA_CodA INTEGER NOT NULL,\n    PRIMARY KEY (STANZA_CodS, DataInizio),\n    FOREIGN KEY (STANZA_CodS) REFERENCES STANZA(CodS),\n    FOREIGN KEY (AGENZIA_CodA) REFERENCES AGENZIA(CodA)\n);\nCREATE TABLE HAS_OPTIONAL (\n    OPTIONAL_Optional TEXT NOT NULL,\n    STANZA_CodS INTEGER NOT NULL,\n    PRIMARY KEY (OPTIONAL_Optional, STANZA_CodS),\n    FOREIGN KEY (STANZA_CodS) REFERENCES STANZA(CodS)\n);\nCREATE TABLE HAS_SPAZI (\n    SPAZI_Spazi TEXT NOT NULL,\n    STANZA_CodS INTEGER NOT NULL,\n    PRIMARY KEY (SPAZI_Spazi, STANZA_CodS),\n    FOREIGN KEY (STANZA_CodS) REFERENCES STANZA(CodS)\n);","itemsArray":[{"__type":"Table","_id":51,"_name":"AGENZIA","_x":62,"_y":391,"_mag":false},{"__type":"Column","_id":53,"_name":"CodA","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":0},{"__type":"Column","_id":54,"_name":"SitoWeb","_type":"text","_identifier":false,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":1},{"__type":"Column","_id":55,"_name":"Tel","_type":"text","_identifier":false,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":2},{"__type":"Column","_id":56,"_name":"Via_Indirizzo","_type":"text","_identifier":false,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":3},{"__type":"Column","_id":57,"_name":"CAP_Indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":4},{"__type":"Column","_id":58,"_name":"Citta_Indirizzo","_type":"text","_identifier":false,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":5},{"__type":"Column","_id":59,"_name":"Numero_Indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":6},{"__type":"Column","_id":60,"_name":"Stato_Indirizzo","_type":"text","_identifier":false,"_unique":false,"_nullable":false,"_tableId":51,"_tableIndex":7},{"__type":"Table","_id":67,"_name":"STANZA","_x":-504,"_y":89,"_mag":false},{"__type":"Column","_id":71,"_name":"CodS","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":67,"_tableIndex":0},{"__type":"Column","_id":72,"_name":"Piano","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":67,"_tableIndex":1},{"__type":"Column","_id":73,"_name":"Superficie","_type":"integer","_identifier":false,"_unique":