wOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false,"showExportMenu":false,"showNotes":false},"schemaDesign":{"model":{"uid":88,"erCode":"/* Entities */\nentity STANZA {\n    CodS (id),\n    piano,\n    superficie,\n    optional (optional, multi)\n}\nentity SUITE {\n    spazi (multi)\n}\nentity AGENZIA {\n    tel,\n    indirizzo {\n        CAP,\n        numero,\n        citta,\n        via,\n        stato\n    },\n    sito_web (optional),\n    CodA (id)\n}\nentity PRENOTAZIONE {\n    data_fine,\n    data_inizio (external),\n    costo\n}\n\n/* Relationships */\nrelationship PER (\n    STANZA: zero..many,\n    PRENOTAZIONE: one..one external\n)\nrelationship STIPULA (\n    PRENOTAZIONE: one..one,\n    AGENZIA: one..many\n)\n\n/* Generalizations */\nSTANZA <= {\n    SUITE\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE STANZA (\n    CodS INTEGER NOT NULL,\n    piano INTEGER NOT NULL,\n    superficie INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (CodS)\n);\nCREATE TABLE PRENOTAZIONE (\n    STANZA_CodS INTEGER NOT NULL,\n    data_inizio INTEGER NOT NULL,\n    data_fine INTEGER NOT NULL,\n    costo INTEGER NOT NULL,\n    AGENZIA_CodA INTEGER NOT NULL,\n    PRIMARY KEY (STANZA_CodS, data_inizio),\n    FOREIGN KEY (STANZA_CodS) REFERENCES STANZA(CodS),\n    ON DELETE NO ACTION,\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (AGENZIA_CodA) REFERENCES AGENZIA(CodA),\n    ON DELETE NO ACTION,\n    ON UPDATE NO ACTION\n);\nCREATE TABLE AGENZIA (\n    CodA INTEGER NOT NULL,\n    tel INTEGER NOT NULL,\n    sito_web INTEGER,\n    CAP_indirizzo INTEGER NOT NULL,\n    numero_indirizzo INTEGER NOT NULL,\n    citta_indirizzo INTEGER NOT NULL,\n    via_indirizzo INTEGER NOT NULL,\n    stato_indirizzo INTEGER NOT NULL,\n    PRIMARY KEY (CodA)\n);\nCREATE TABLE HAS_SPAZI (\n    SPAZI_spazi INTEGER NOT NULL,\n    STANZA_CodS INTEGER NOT NULL,\n    PRIMARY KEY (SPAZI_spazi, STANZA_CodS),\n    FOREIGN KEY (STANZA_CodS) REFERENCES STANZA(CodS),\n    ON DELETE NO ACTION,\n    ON UPDATE NO ACTION\n);\nCREATE TABLE HAS_OPTIONAL (\n    OPTIONAL_optional INTEGER NOT NULL,\n    STANZA_CodS INTEGER NOT NULL,\n    PRIMARY KEY (OPTIONAL_optional, STANZA_CodS),\n    FOREIGN KEY (STANZA_CodS) REFERENCES STANZA(CodS),\n    ON DELETE NO ACTION,\n    ON UPDATE NO ACTION\n);","itemsArray":[{"__type":"Table","_id":53,"_name":"STANZA","_x":-1136,"_y":-316,"_mag":false},{"__type":"Column","_id":57,"_name":"CodS","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":53,"_tableIndex":0},{"__type":"Column","_id":58,"_name":"piano","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":53,"_tableIndex":1},{"__type":"Column","_id":59,"_name":"superficie","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":53,"_tableIndex":2},{"__type":"Column","_id":60,"_name":"Type","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":53,"_tableIndex":3},{"__type":"Table","_id":61,"_name":"PRENOTAZIONE","_x":-832,"_y":-360,"_mag":false},{"__type":"Column","_id":62,"_name":"STANZA_CodS","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":61,"_tableIndex":0},{"__type":"ForeignKey","_id":63,"_referencingColumnId":62,"_referencedColumnId":57},{"__type":"Column","_id":65,"_name":"data_inizio","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":61,"_tableIndex":1},{"__type":"Column","_id":66,"_name":"data_fine","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":61,"_tableIndex":2},{"__type":"Column","_id":67,"_name":"costo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":61,"_tableIndex":3},{"__type":"Table","_id":68,"_name":"AGENZIA","_x":-457,"_y":-350,"_mag":false},{"__type":"Column","_id":70,"_name":"CodA","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":68,"_tableI