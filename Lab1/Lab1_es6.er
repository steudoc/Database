= {\n    QUALITA,\n    PRODUZIONE\n} (total, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE OPERAIO (\n    codO INTEGER NOT NULL,\n    cognome INTEGER NOT NULL,\n    tel INTEGER,\n    nome INTEGER NOT NULL,\n    PRIMARY KEY (codO)\n);\nCREATE TABLE MACCHINARIO (\n    codM INTEGER NOT NULL,\n    marca INTEGER NOT NULL,\n    modello INTEGER NOT NULL,\n    parametro INTEGER,\n    consumo_energia INTEGER,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (codM)\n);\nCREATE TABLE ISPEZIONE (\n    MACCHINARIO_codM INTEGER NOT NULL,\n    OPERAIO_codO INTEGER NOT NULL,\n    data_inizio INTEGER NOT NULL,\n    ora_inizio INTEGER NOT NULL,\n    ora_fine INTEGER NOT NULL,\n    data_fine INTEGER NOT NULL,\n    PRIMARY KEY (MACCHINARIO_codM, OPERAIO_codO, data_inizio, ora_inizio),\n    FOREIGN KEY (MACCHINARIO_codM) REFERENCES MACCHINARIO(codM),\n    FOREIGN KEY (OPERAIO_codO) REFERENCES OPERAIO(codO)\n);\nCREATE TABLE PRODOTTO (\n    codBarre INTEGER NOT NULL,\n    ore_produzione INTEGER NOT NULL,\n    costo INTEGER NOT NULL,\n    PRIMARY KEY (codBarre)\n);\nCREATE TABLE ASSEGNATO (\n    OPERAIO_codO INTEGER NOT NULL,\n    PRODOTTO_codBarre INTEGER NOT NULL,\n    PRIMARY KEY (OPERAIO_codO, PRODOTTO_codBarre),\n    FOREIGN KEY (OPERAIO_codO) REFERENCES OPERAIO(codO),\n    FOREIGN KEY (PRODOTTO_codBarre) REFERENCES PRODOTTO(codBarre)\n);\nCREATE TABLE HAS_CATEGORIE (\n    PRODOTTO_codBarre INTEGER NOT NULL,\n    CATEGORIE_categorie INTEGER NOT NULL,\n    PRIMARY KEY (PRODOTTO_codBarre, CATEGORIE_categorie),\n    FOREIGN KEY (PRODOTTO_codBarre) REFERENCES PRODOTTO(codBarre)\n);","itemsArray":[{"__type":"Table","_id":50,"_name":"OPERAIO","_x":-72,"_y":180,"_mag":false},{"__type":"Column","_id":53,"_name":"codO","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":50,"_tableIndex":0},{"__type":"Column","_id":54,"_name":"cognome","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":50,"_tableIndex":1},{"__type":"Column","_id":55