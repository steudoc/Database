ntifier":false,"_unique":false,"_nullable":false,"_tableId":68,"_tableIndex":4},"78":{"__type":"Column","_id":78,"_name":"durata","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":68,"_tableIndex":5},"79":{"__type":"Table","_id":79,"_name":"CONVENZIONE","_x":-162,"_y":-85,"_mag":false},"80":{"__type":"Column","_id":80,"_name":"AZIENDA_IVA","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":0},"81":{"__type":"ForeignKey","_id":81,"_referencingColumnId":80,"_referencedColumnId":49},"82":{"__type":"Column","_id":82,"_name":"OFFICINA_codO","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":1},"83":{"__type":"ForeignKey","_id":83,"_referencingColumnId":82,"_referencedColumnId":54},"84":{"__type":"Column","_id":84,"_name":"AZIENDA_IVA","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":43,"_tableIndex":1},"85":{"__type":"ForeignKey","_id":85,"_referencingColumnId":84,"_referencedColumnId":49}}},"edited":true,"sceneResetToken":1712560867618,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":"<p><span class=\"ql-size-large\">Si vuole progettare la base di dati per la gestione delle riparazioni di furgoni. La base di dati deve</span></p><p><span class=\"ql-size-large\">memorizzare le informazioni relative a un elenco di furgoni, identificati ciascuno dalla targa e per i</span></p><p><span class=\"ql-size-large\">quali è noto l’anno di immatricolazione. Tra i vari tipi di furgone, per quelli dotati di motore elettrico</span></p><p><span class=\"ql-size-large\">è nota la capacità della batteria. La base di dati deve anche contenere l’elenco delle officine, identificate</span></p><p><span class=\"ql-size-large\">da un codice univoco e per le quali è inoltre noto l’indirizzo. Le officine possono essere convenzionate</span></p><p><span class=\"ql-size-large\">con alcune aziende. Delle aziende convenzionate sono noti partita IVA, nome ed elenco degli eventuali</span></p><p><span class=\"ql-size-large\">numeri di telefono. Si noti che ogni azienda può essere convenzionata con più officine, e si vuole</span></p><p><span class=\"ql-size-large\">tenere traccia solo delle aziende convenzionate con almeno una officina. Si vuole inoltre tenere traccia</span></p><p><span class=\"ql-size-large\">delle riparazioni effettuate nel tempo su ciascun furgone. Di ogni riparazione sono noti la data, il costo</span></p><p><span class=\"ql-size-large\">e la durata in ore. Si noti che un furgone può subire più riparazioni nello stesso giorno ma in officine</span></p><p><span class=\"ql-size-large\">diverse. Un’officina effettua al massimo una riparazione per uno stesso furgone nello stesso giorno.</span></p>"}