ZIENDA {\n    nome,\n    IVA (id),\n    tel (optional, multi)\n}\nentity TEMPO {\n    data (id),\n    ora (id)\n}\n\n/* Relationships */\nrelationship CONVENZIONE (\n    AZIENDA: one..many,\n    OFFICINA: zero..many\n)\nrelationship RIPARAZIONE (\n    FURGONE: zero..many,\n    OFFICINA: zero..many,\n    TEMPO: one..many\n) {\n    costo,\n    durata\n}\n\n/* Generalizations */\nFURGONE <= {\n    ELETTRICO\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE TEL (\n    tel INTEGER NOT NULL,\n    AZIENDA_IVA INTEGER NOT NULL,\n    PRIMARY KEY (tel),\n    FOREIGN KEY (AZIENDA_IVA) REFERENCES AZIENDA(IVA)\n);\nCREATE TABLE AZIENDA (\n    IVA INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    PRIMARY KEY (IVA)\n);\nCREATE TABLE OFFICINA (\n    codO INTEGER NOT NULL,\n    numero_indirizzo INTEGER NOT NULL,\n    via_indirizzo INTEGER NOT NULL,\n    citta_indirizzo INTEGER NOT NULL,\n    PRIMARY KEY (codO)\n);\nCREATE TABLE FURGONE (\n    targa INTEGER NOT NULL,\n    anno_imm INTEGER NOT NULL,\n    batteria INTEGER,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (targa)\n);\nCREATE TABLE TEMPO (\n    data INTEGER NOT NULL,\n    ora INTEGER NOT NULL,\n    PRIMARY KEY (data, ora)\n);\nCREATE TABLE RIPARAZIONE (\n    OFFICINA_codO INTEGER NOT NULL,\n    FURGONE_targa INTEGER NOT NULL,\n    TEMPO_data INTEGER NOT NULL,\n    TEMPO_ora INTEGER NOT NULL,\n    costo INTEGER NOT NULL,\n    durata INTEGER NOT NULL,\n    PRIMARY KEY (OFFICINA_codO, FURGONE_targa, TEMPO_data, TEMPO_ora),\n    FOREIGN KEY (OFFICINA_codO) REFERENCES OFFICINA(codO),\n    FOREIGN KEY (FURGONE_targa) REFERENCES FURGONE(targa),\n    FOREIGN KEY (TEMPO_data) REFERENCES TEMPO(data),\n    FOREIGN KEY (TEMPO_ora) REFERENCES TEMPO(ora)\n);\nCREATE TABLE CONVENZIONE (\n    AZIENDA_IVA INTEGER NOT NULL,\n    OFFICINA_codO INTEGER NOT NULL,\n    PRIMARY KEY (AZIENDA_IVA, OFFICINA_codO),\n    FOREIGN KEY (AZIENDA_IVA) REFERENCES AZIENDA(IVA),\n    FOREIGN KEY (OFFICINA_codO) REFERENCES OFFICINA(codO)\n);","ite