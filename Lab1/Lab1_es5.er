d":80,"erCode":"/* Entities */\nentity DIPENDENTE {\n    codD (id),\n    email,\n    qualifiche (multi),\n    nome\n}\nentity IMPIEGATI {\n    mansione\n}\nentity EDIFICIO {\n    codE (id),\n    indirizzo {\n        numero,\n        via,\n        citta\n    },\n    tel (multi)\n}\nentity TURNO {\n    ora_inizio,\n    ora_fine,\n    data (external),\n    ordinario\n}\n\n/* Relationships */\nrelationship PRESSO (\n    TURNO: one..one,\n    EDIFICIO: zero..many\n)\nrelationship LAVORA (\n    DIPENDENTE: zero..many,\n    TURNO: one..one external\n)\n\n/* Generalizations */\nDIPENDENTE <= {\n    IMPIEGATI\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE DIPENDENTE (\n    codD INTEGER NOT NULL,\n    email INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    mansione INTEGER,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (codD)\n);\nCREATE TABLE TEL (\n    tel INTEGER NOT NULL,\n    EDIFICIO_codE INTEGER NOT NULL,\n    PRIMARY KEY (tel),\n    FOREIGN KEY (EDIFICIO_codE) REFERENCES EDIFICIO(codE)\n);\nCREATE TABLE EDIFICIO (\n    codE INTEGER NOT NULL,\n    numero_indirizzo INTEGER NOT NULL,\n    via_indirizzo INTEGER NOT NULL,\n    citta_indirizzo INTEGER NOT NULL,\n    PRIMARY KEY (codE)\n);\nCREATE TABLE TURNO (\n    DIPENDENTE_codD INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    ora_inizio INTEGER NOT NULL,\n    ora_fine INTEGER NOT NULL,\n    ordinario INTEGER NOT NULL,\n    EDIFICIO_codE INTEGER NOT NULL,\n    PRIMARY KEY (DIPENDENTE_codD, data),\n    FOREIGN KEY (DIPENDENTE_codD) REFERENCES DIPENDENTE(codD),\n    FOREIGN KEY (EDIFICIO_codE) REFERENCES EDIFICIO(codE)\n);\nCREATE TABLE HAS_QUALIFICHE (\n    QUALIFICHE_qualifiche INTEGER NOT NULL,\n    DIPENDENTE_codD INTEGER NOT NULL,\n    PRIMARY KEY (QUALIFICHE_qualifiche, DIPENDENTE_codD),\n    FOREIGN KEY (DIPENDENTE_codD) REFERENCES DIPENDENTE(codD)\n);","itemsArray":[{"__type":"Table","_id":46,"_name":"DIPENDENTE","_x":-429,"_y":-142,"_mag":false},{"__type":"Column","_id":49,"_name":"codD","_type":"