unique":false,"_nullable":false,"_tableId":64,"_tableIndex":3},"71":{"__type":"Column","_id":71,"_name":"ordinario","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":64,"_tableIndex":4},"72":{"__type":"Column","_id":72,"_name":"EDIFICIO_codE","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":64,"_tableIndex":5},"73":{"__type":"ForeignKey","_id":73,"_referencingColumnId":72,"_referencedColumnId":60},"74":{"__type":"Column","_id":74,"_name":"EDIFICIO_codE","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":54,"_tableIndex":1},"75":{"__type":"ForeignKey","_id":75,"_referencingColumnId":74,"_referencedColumnId":60},"76":{"__type":"Table","_id":76,"_name":"HAS_QUALIFICHE","_x":-730,"_y":11,"_mag":false},"77":{"__type":"Column","_id":77,"_name":"QUALIFICHE_qualifiche","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":76,"_tableIndex":0},"78":{"__type":"Column","_id":78,"_name":"DIPENDENTE_codD","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":76,"_tableIndex":1},"79":{"__type":"ForeignKey","_id":79,"_referencingColumnId":78,"_referencedColumnId":49}}},"edited":true,"sceneResetToken":1712569268979,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":"<p><span class=\"ql-size-large\">Si vuole progettare la base di dati per la gestione di turni di personale presso diversi edifici aziendali.</span></p><p><span class=\"ql-size-large\">La base di dati deve contenere un elenco di dipendenti. I dipendenti sono identificati da un codice</span></p><p><span class=\"ql-size-large\">univoco all’interno dell’azienda e sono caratterizzati dal nome, dall’indirizzo email, e dall’elenco delle</span></p><p><span class=\"ql-size-large\">qualifiche. I dipendenti possono essere operai o impiegati, e per gli impiegati è nota la mansione. La</span></p><p><span class=\"ql-size-large\">base di dati deve contenere l’elenco degli edifici dell’azienda, identificati da un codice univoco e</span></p><p><span class=\"ql-size-large\">caratterizzati dall’indirizzo e dall’elenco di numeri di telefono.</span></p><p><span class=\"ql-size-large\">Si vuole tenere traccia di tutti i turni di lavoro di ciascun dipendente presso i vari edifici. Un turno di</span></p><p><span class=\"ql-size-large\">lavoro è caratterizzato da una data, un orario di inizio e un orario di fine, l’edificio presso cui si svolge,</span></p><p><span class=\"ql-size-large\">e può essere o ordinario o straordinario. Un turno è associato ad un solo dipendente e ad un solo</span></p><p><span class=\"ql-size-large\">edificio. Uno stesso dipendente può svolgere turni in edifici diversi. Tuttavia un dipendente può avere</span></p><p><span class=\"ql-size-large\">un solo turno nello stesso giorno.</span></p>"}