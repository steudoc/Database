GN KEY (IMMOBILE_codCatasto) REFERENCES IMMOBILE(codCatasto),\n    FOREIGN KEY (AGENZIA_codA) REFERENCES AGENZIA(codA)\n);\nCREATE TABLE TEL (\n    tel INTEGER NOT NULL,\n    AGENZIA_codA INTEGER NOT NULL,\n    PRIMARY KEY (tel),\n    FOREIGN KEY (AGENZIA_codA) REFERENCES AGENZIA(codA)\n);\nCREATE TABLE AGENZIA (\n    codA INTEGER NOT NULL,\n    numero_indirizzo INTEGER NOT NULL,\n    via_indirizzo INTEGER NOT NULL,\n    citta_indirizzo INTEGER NOT NULL,\n    PRIMARY KEY (codA)\n);","itemsArray":[{"__type":"Table","_id":49,"_name":"STANZE","_x":-753,"_y":-130,"_mag":true},{"__type":"Column","_id":51,"_name":"stanze","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":49,"_tableIndex":0},{"__type":"Table","_id":52,"_name":"IMMOBILE","_x":-362,"_y":-183,"_mag":false},{"__type":"Column","_id":55,"_name":"codCatasto","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":52,"_tableIndex":0},{"__type":"Column","_id":56,"_name":"sup","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":52,"_tableIndex":1},{"__type":"Column","_id":57,"_name":"piano","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":52,"_tableIndex":2},{"__type":"Column","_id":58,"_name":"Type","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":52,"_tableIndex":3},{"__type":"Column","_id":59,"_name":"numero_indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":52,"_tableIndex":4},{"__type":"Column","_id":60,"_name":"via_indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":52,"_tableIndex":5},{"__type":"Column","_id":61,"_name":"citta_indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":52,"_tableIndex":6},{"__type":"Table","_id":62,"_name":"CONTRATTO","_x":66,"_y":-239,"_mag":false},{"__type":"Column","_id":63,"_name":"IMMOBILE_codCatasto"