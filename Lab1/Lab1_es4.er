ame":"citta","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":83,"_tableIndex":0},"87":{"__type":"Column","_id":87,"_name":"abitanti","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":83,"_tableIndex":1},"88":{"__type":"Column","_id":88,"_name":"superficie","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":83,"_tableIndex":2},"89":{"__type":"Table","_id":89,"_name":"COMUNI","_x":18,"_y":181,"_mag":true},"91":{"__type":"Column","_id":91,"_name":"comuni","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":89,"_tableIndex":0},"92":{"__type":"Column","_id":92,"_name":"AREA_GEO_citta","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":89,"_tableIndex":1},"93":{"__type":"ForeignKey","_id":93,"_referencingColumnId":92,"_referencedColumnId":86},"94":{"__type":"Table","_id":94,"_name":"COPRE","_x":127,"_y":-105,"_mag":false},"95":{"__type":"Column","_id":95,"_name":"AGENTE_CF","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":94,"_tableIndex":0},"96":{"__type":"ForeignKey","_id":96,"_referencingColumnId":95,"_referencedColumnId":70},"97":{"__type":"Column","_id":97,"_name":"AREA_GEO_citta","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":94,"_tableIndex":1},"98":{"__type":"ForeignKey","_id":98,"_referencingColumnId":97,"_referencedColumnId":86}}},"edited":true,"sceneResetToken":1712562699390,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":"<p><span class=\"ql-size-large\">Si vuole progettare la base di dati per la gestione dei mandati degli agenti presso alcune agenzie</span></p><p><span class=\"ql-size-large\">immobiliari. La base di dati deve contenere un elenco di agenti. Gli agenti sono identificati dal codice</span></p><p><span class=\"ql-size-large\">fiscale e sono caratterizzati dal nome completo, dal numero di telefono e possono avere un indirizzo</span></p><p><span class=\"ql-size-large\">e-mail. Ogni agente copre una o più aree geografiche. Ogni area geografica è identificata dalla città principale ed è caratterizzata dall’elenco di eventuali altri comuni inclusi nell’area, dal numero totale di abitanti e dalla superficie in km quadrati.</span></p><p><span class=\"ql-size-large\">La base di dati deve memorizzare un elenco di agenzie immobiliari. Le agenzie sono identificate da</span></p><p><span class=\"ql-size-large\">un codice univoco e sono caratterizzate da un indirizzo. Le agenzie possono essere indipendenti o in franchising. Per le agenzie indipendenti è nota la partita IVA del titolare. Per le agenzie in franchising</span></p><p><span class=\"ql-size-large\">è noto il nome della catena a cui appartengono.</span></p><p><span class=\"ql-size-large\">Si vuole tenere traccia di tutti i mandati che le agenzie hanno assegnato agli agenti. Un agente può aver ricevuto più mandati dalla stessa agenzia in momenti diversi. Un’agenzia può aver assegnato più</span></p><p><span class=\"ql-size-large\">mandati allo stesso agente in momenti diversi. Nello stesso istante un agente può avere più mandati da</span></p><p><span class=\"ql-size-large\">agenzie diverse. Bisogna tenere traccia della data di inizio, della data di fine e del tipo di mandato.</span></p>"}