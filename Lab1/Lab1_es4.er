e,"showExportMenu":false,"showNotes":false},"schemaDesign":{"model":{"uid":99,"erCode":"/* Entities */\nentity AGENTE {\n    CF (id),\n    cognome,\n    tel,\n    nome,\n    email (optional)\n}\nentity AREA_GEO {\n    citta (id),\n    abitanti,\n    superficie,\n    comuni (optional, multi)\n}\nentity AGENZIA {\n    codA (id),\n    indirizzo {\n        numero,\n        via,\n        citta\n    }\n}\nentity INDIPENDENTI {\n    IVA\n}\nentity FRANCHISING {\n    catena\n}\nentity MANDATO {\n    data_inizio (external),\n    data_fine,\n    tipo\n}\n\n/* Relationships */\nrelationship COPRE (\n    AGENTE: one..many,\n    AREA_GEO: zero..many\n)\nrelationship RICEVE (\n    MANDATO: one..one external,\n    AGENTE: zero..many\n)\nrelationship COMMISSIONA (\n    MANDATO: one..one external,\n    AGENZIA: zero..many\n)\n\n/* Generalizations */\nAGENZIA <= {\n    INDIPENDENTI,\n    FRANCHISING\n} (total, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE AGENZIA (\n    codA INTEGER NOT NULL,\n    IVA INTEGER,\n    catena INTEGER,\n    Type INTEGER NOT NULL,\n    numero_indirizzo INTEGER NOT NULL,\n    via_indirizzo INTEGER NOT NULL,\n    citta_indirizzo INTEGER NOT NULL,\n    PRIMARY KEY (codA)\n);\nCREATE TABLE AGENTE (\n    CF INTEGER NOT NULL,\n    cognome INTEGER NOT NULL,\n    tel INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    email INTEGER,\n    PRIMARY KEY (CF)\n);\nCREATE TABLE MANDATO (\n    AGENTE_CF INTEGER NOT NULL,\n    AGENZIA_codA INTEGER NOT NULL,\n    data_inizio INTEGER NOT NULL,\n    data_fine INTEGER NOT NULL,\n    tipo INTEGER NOT NULL,\n    PRIMARY KEY (AGENTE_CF, AGENZIA_codA, data_inizio),\n    FOREIGN KEY (AGENTE_CF) REFERENCES AGENTE(CF),\n    FOREIGN KEY (AGENZIA_codA) REFERENCES AGENZIA(codA)\n);\nCREATE TABLE AREA_GEO (\n    citta INTEGER NOT NULL,\n    abitanti INTEGER NOT NULL,\n    superficie INTEGER NOT NULL,\n    PRIMARY KEY (citta)\n);\nCREATE TABLE COMUNI (\n    comuni INTEGER NOT NULL,\n    AREA_GEO_citta INTEGER NOT NULL,\n    PRIMARY KEY (comuni),\n    FOREIGN KEY (AREA_GEO_citta) REFERENCES AREA_GEO(citta)\n);\nCREATE TABLE COPRE (\n    AGENTE_CF INTEGER NOT NULL,\n    AREA_GEO_citta INTEGER NOT NULL,\n    PRIMARY KEY (AGENTE_CF, AREA_GEO_citta),\n    FOREIGN KEY (AGENTE_CF) REFERENCES AGENTE(CF),\n    FOREIGN KEY (AREA_GEO_citta) REFERENCES AREA_GEO(citta)\n);","itemsArray":[{"__type":"Table","_id":58,"_name":"AGENZIA","_x":-703,"_y":101,"_mag":false},{"__type":"Column","_id":60,"_name":"codA","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":58,"_tableIndex":0},{"__type":"Column","_id":61,"_name":"IVA","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":58,"_tableIndex":1},{"__type":"Column","_id":62,"_name":"catena","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":58,"_tableIndex":2},{"__type":"Column","_id":63,"_name":"Type","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":58,"_tableIndex":3},{"__type":"Column","_id":64,"_name":"numero_indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":58,"_tableIndex":4},{"__type":"Column","_id":65,"_name":"via_indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":58,"_tableIndex":5},{"__type":"Column","_id":66,"_name":"citta_indirizzo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":58,"_tableIndex":6},{"__type":"Table","_id":67,"_name":"AGENTE","_x":-131,"_y":-212,"_mag":false},{"__type":"Column","_id":70,"_name":"CF","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":67,"_tableIndex":0},{"__type":"Column","_id":71,"_name":"cognome","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":67,"_tableIndex":1},{"__type":"Column","_id":72,"_name":"tel","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":67,"_tableIndex":2},{"__typ