odM (id),\n    indirizzo {\n        numero,\n        via,\n        citta\n    },\n    azienda\n}\nentity TRASLOCO {\n    data (external),\n    autista,\n    ora_partenza,\n    ora_arrivo\n}\n\n/* Relationships */\nrelationship EFFETTUA (\n    FURGONE: zero..many,\n    TRASLOCO: one..one external\n)\nrelationship DA (\n    TRASLOCO: one..one,\n    MAGAZZINO: zero..many\n)\nrelationship A (\n    TRASLOCO: one..one,\n    MAGAZZINO: zero..many\n)\n\n/* Generalizations */\nFURGONE <= {\n    SPECIALI\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE FURGONE (\n    targa INTEGER NOT NULL,\n    modello INTEGER NOT NULL,\n    volume INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (targa)\n);\nCREATE TABLE TRASLOCO (\n    FURGONE_targa INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    autista INTEGER NOT NULL,\n    ora_partenza INTEGER NOT NULL,\n    ora_arrivo INTEGER NOT NULL,\n    codM_partenza INTEGER NOT NULL,\n    codM_arrivo INTEGER NOT NULL,\n    PRIMARY KEY (FURGONE_targa, data),\n    FOREIGN KEY (FURGONE_targa) REFERENCES FURGONE(targa),\n    FOREIGN KEY (codM_partenza) REFERENCES MAGAZZINO(codM),\n    FOREIGN KEY (codM_arrivo) REFERENCES MAGAZZINO(codM)\n);\nCREATE TABLE MAGAZZINO (\n    codM INTEGER NOT NULL,\n    azienda INTEGER NOT NULL,\n    numero_indirizzo INTEGER NOT NULL,\n    via_indirizzo INTEGER NOT NULL,\n    citta_indirizzo INTEGER NOT NULL,\n    PRIMARY KEY (codM)\n);\nCREATE TABLE HAS_CERTIFICAZIONI (\n    FURGONE_targa INTEGER NOT NULL,\n    CERTIFICAZIONI_certificazioni INTEGER NOT NULL,\n    PRIMARY KEY (FURGONE_targa, CERTIFICAZIONI_certificazioni),\n    FOREIGN KEY (FURGONE_targa) REFERENCES FURGONE(targa)\n);","itemsArray":[{"__type":"Table","_id":46,"_name":"FURGONE","_x":-343,"_y":347,"_mag":false},{"__type":"Column","_id":49,"_name":"targa","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":46,"_tableIndex":0},{"__type":"Column","_id":50,"_name":"modello","_type":"integer","_identif